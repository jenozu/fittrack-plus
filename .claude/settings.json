{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "permissions": {
    "allow": [
      "Bash(python .taskmaster/tasks.py *)",
      "Bash(python3 .taskmaster/tasks.py *)",
      "Bash(python .taskmaster/render_tasks_md.py)",
      "Bash(python3 .taskmaster/render_tasks_md.py)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(shellcheck *)",
      "Bash(docker compose -f scripts/local/docker-compose.dev.yml *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Read(./backend/.env)",
      "Read(./**/.env.*)"
    ]
  }
}
